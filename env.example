# ──────────────────────────────────────────────
# EXISTING (Davin's backend — you probably already have these)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
BUCKET_BASE_IMAGES=camouflage-base-images
BUCKET_PATTERNS=camouflage-patterns
BUCKET_APPLIED_MODELS=camouflage-applied-models

# ──────────────────────────────────────────────
# NEW — AI Model Settings
# ──────────────────────────────────────────────

# HuggingFace access token (REQUIRED for SD3)
# Get this from: https://huggingface.co/settings/tokens
# You also need to accept the SD3 license at:
# https://huggingface.co/stabilityai/stable-diffusion-3-medium-diffusers
HF_TOKEN=hf_your_token_here

# Device override (OPTIONAL — auto-detects if not set)
# Your M3 Mac will auto-detect "mps"
# Uncomment only if you want to force a specific device
# AI_DEVICE=mps

# LoRA weights path (OPTIONAL — leave unset to use base SD3)
# Set this later when you've trained your own LoRA adapter
# LORA_WEIGHTS_PATH=models/sd3_lora_camo.safetensors
